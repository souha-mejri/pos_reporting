"""
Base de données SQLite du projet (fichier unique, aucun service externe requis).

Deux tables :
- users       : comptes (admin / user), mots de passe hashés
- parametres  : réglages modifiables depuis l'interface admin sans redémarrer
                le serveur (clé API active, fournisseur IA actif, etc.)
"""

import os
import sqlite3
from pathlib import Path

from werkzeug.security import generate_password_hash

CHEMIN_DB = Path(__file__).resolve().parent.parent / "data" / "app.db"
CHEMIN_DB.parent.mkdir(parents=True, exist_ok=True)


def get_connexion() -> sqlite3.Connection:
    conn = sqlite3.connect(CHEMIN_DB)
    conn.row_factory = sqlite3.Row
    return conn


def init_db() -> None:
    """Crée les tables si elles n'existent pas, et l'admin initial si la base est vide."""
    with get_connexion() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                username TEXT UNIQUE NOT NULL,
                password_hash TEXT NOT NULL,
                role TEXT NOT NULL CHECK(role IN ('admin','user')),
                actif INTEGER NOT NULL DEFAULT 1
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS parametres (
                cle TEXT PRIMARY KEY,
                valeur TEXT
            )
        """)
        conn.commit()

        # Admin initial : créé une seule fois, à partir de .env, si la base est vide.
        nb_users = conn.execute("SELECT COUNT(*) AS n FROM users").fetchone()["n"]
        if nb_users == 0:
            username_initial = os.environ.get("ADMIN_USERNAME", "admin")
            password_initial = os.environ.get("ADMIN_PASSWORD", "changeme123")
            conn.execute(
                "INSERT INTO users (username, password_hash, role, actif) VALUES (?, ?, 'admin', 1)",
                (username_initial, generate_password_hash(password_initial)),
            )
            conn.commit()


# ==========================================
# Paramètres (clé API active, fournisseur IA, etc.)
# ==========================================
def get_parametre(cle: str, defaut: str | None = None) -> str | None:
    with get_connexion() as conn:
        row = conn.execute("SELECT valeur FROM parametres WHERE cle = ?", (cle,)).fetchone()
        return row["valeur"] if row else defaut


def set_parametre(cle: str, valeur: str) -> None:
    with get_connexion() as conn:
        conn.execute(
            "INSERT INTO parametres (cle, valeur) VALUES (?, ?) "
            "ON CONFLICT(cle) DO UPDATE SET valeur = excluded.valeur",
            (cle, valeur),
        )
        conn.commit()


# ==========================================
# Utilisateurs
# ==========================================
def trouver_utilisateur_par_nom(username: str):
    with get_connexion() as conn:
        return conn.execute("SELECT * FROM users WHERE username = ?", (username,)).fetchone()


def trouver_utilisateur_par_id(user_id: int):
    with get_connexion() as conn:
        return conn.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()


def lister_utilisateurs():
    with get_connexion() as conn:
        return conn.execute("SELECT id, username, role, actif FROM users ORDER BY id").fetchall()


def creer_utilisateur(username: str, password: str, role: str) -> tuple[bool, str]:
    if role not in ("admin", "user"):
        return False, "Rôle invalide."
    with get_connexion() as conn:
        try:
            conn.execute(
                "INSERT INTO users (username, password_hash, role, actif) VALUES (?, ?, ?, 1)",
                (username, generate_password_hash(password), role),
            )
            conn.commit()
            return True, "Utilisateur créé."
        except sqlite3.IntegrityError:
            return False, "Ce nom d'utilisateur existe déjà."


def basculer_acces(user_id: int) -> None:
    with get_connexion() as conn:
        conn.execute("UPDATE users SET actif = 1 - actif WHERE id = ?", (user_id,))
        conn.commit()


def supprimer_utilisateur(user_id: int) -> None:
    with get_connexion() as conn:
        conn.execute("DELETE FROM users WHERE id = ?", (user_id,))
        conn.commit()